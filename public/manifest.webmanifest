{
  "name": "NutriScan - Food Nutrition Analyzer",
  "short_name": "NutriScan",
  "description": "Smart Food Nutrition Analyzer - Detect food and calculate calories, protein, carbs, fats, vitamins and minerals",
  "start_url": "/?source=pwa",
  "scope": "/",
  "id": "nutriscan-pwa-v1",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "theme_color": "#26b15e",
  "background_color": "#f6f9f7",
  "categories": ["health", "fitness", "food", "lifestyle", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192x192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512x512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "NutriScan - Scan Food Nutrition"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide",
      "label": "NutriScan - Food Nutrition Dashboard"
    }
  ],
  "shortcuts": [
    {
      "name": "Scan Food",
      "short_name": "Scan",
      "description": "Scan a food photo to analyze nutrition",
      "url": "/?tab=scan",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Daily Tracker",
      "short_name": "Tracker",
      "description": "View daily calories and food log",
      "url": "/?tab=tracker",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192" }]
    }
  ]
}


